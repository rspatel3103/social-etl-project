# Example .env file for social_etl
#
# Copy this file to `.env` and fill in your actual credentials. Never
# commit your real secrets to version control! The application reads
# these variables at runtime via social_etl.utils.env_loader.load_env.

# --------------------------------------------------------------------
# Instagram API credentials
#
# The access token must be generated from the Instagram Graph API and
# have the `instagram_manage_insights` permission. The account ID is
# the numeric identifier for your Instagram business account.
INSTAGRAM_ACCOUNT_ID=17841449129086190

# --------------------------------------------------------------------
# LinkedIn API credentials
#
# LinkedIn's Marketing Developer Platform requires a developer
# application and approval for the appropriate scopes. Use a valid
# token here when you have one.
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token

# --------------------------------------------------------------------
# Facebook API credentials
#
# To retrieve Page insights you need a page ID and an access token
# with the `pages_read_engagement` permission.
FACEBOOK_PAGE_ID=651808378026760

# --------------------------------------------------------------------
# Twitter (X) API credentials
#
# Provide either a Bearer token (for app‑only authentication) or
# separate API key/secret if you implement OAuth. See the Twitter
# developer portal for details.
X_BEARER_TOKEN=your_x_bearer_token
# X_API_KEY=your_x_api_key
# X_API_SECRET=your_x_api_secret

# --------------------------------------------------------------------
# SQL Server connection string
#
# Connection string used by pyodbc to connect to your database. This
# string can include UID and PWD or rely on trusted connections.
# See https://learn.microsoft.com/sql/connect/odbc/applications/create-an-odbc-data-source for guidance.
SQL_CONN_STR=DRIVER={ODBC Driver 17 for SQL Server};SERVER=IT-RP-LT\SQLEXPRESS;DATABASE=firedrake25;Trusted_Connection=yes;
